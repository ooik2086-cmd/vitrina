<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds talk to the local dev server over plain HTTP (10.0.2.2): res/xml/network_security_config.xml
         here allows it (Android reads that file, not this flag, once it is set). Release builds stay HTTPS-only,
         but for the 3D stage on 127.0.0.1. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
