<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same as backup_rules.xml, for backups and for moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="chat_photos/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="chat_photos/" />
    </device-transfer>
</data-extraction-rules>
