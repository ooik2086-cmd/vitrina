# The one public entrance: HTTPS for VITRINA_DOMAIN (certificate from Let's Encrypt, renewed by Caddy), plain
# http redirected to it, everything passed to the API. With VITRINA_STORAGE=disk the photos are served here from
# their volume (with s3, phones load them from the bucket and /media is empty).
{$VITRINA_DOMAIN} {
	tls {$VITRINA_TLS}
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	# A photo's name is random and never reused (an edit makes a new one): phones may keep it for a year.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server
	}
	handle {
		reverse_proxy api:8000
	}
}
