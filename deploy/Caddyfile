# The one public entrance: HTTPS for VITRINA_DOMAIN (certificate from Let's Encrypt, renewed by Caddy), plain
# http redirected to it, everything passed to the API. With VITRINA_STORAGE=disk the photos are served from their
# volume by the media service (Caddyfile.media); with s3, phones load them from the bucket and /media is empty.
{$VITRINA_DOMAIN} {
	tls {$VITRINA_TLS}
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	handle_path /media/* {
		reverse_proxy media:8080
	}
	handle {
		reverse_proxy api:8000
	}
}
