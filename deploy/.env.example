# Copy of what deploy/setup.sh writes to deploy/.env. Never commit .env: it holds the secrets.

# The site's name and an email Let's Encrypt writes to about the certificate. The domain's A record must point
# at this server before the first start.
VITRINA_DOMAIN=vitrina.kz
VITRINA_TLS=you@example.kz
# Browser origins allowed to call the API: the site itself (the support console at /admin is served from it).
VITRINA_CORS_ORIGINS=https://vitrina.kz

# Made by setup.sh: random, at least 32 characters. Keep a copy somewhere safe: without POSTGRES_PASSWORD the
# backups still restore, but sign-in codes and webhook signatures change if the others are lost.
POSTGRES_PASSWORD=
VITRINA_OTP_SECRET=
VITRINA_PAYMENT_SECRET=
VITRINA_DELIVERY_SECRET=

# S3-compatible storage keeping the data in Kazakhstan (the personal-data law: backups hold phones and addresses,
# the private bucket receipts): three buckets on one endpoint.
#   VITRINA_S3_BUCKET          photos, public read; VITRINA_PUBLIC_MEDIA_URL is its public address (or a CDN's)
#   VITRINA_S3_PRIVATE_BUCKET  receipts and dispute evidence, NOT public
#   VITRINA_S3_BACKUP_BUCKET   the database's nightly copies, NOT public (its own key, if any: deploy/backup.env)
VITRINA_S3_ENDPOINT=https://s3.example.kz
VITRINA_S3_REGION=us-east-1
VITRINA_S3_ACCESS_KEY=
VITRINA_S3_SECRET_KEY=
VITRINA_S3_BUCKET=vitrina-photos
VITRINA_S3_PRIVATE_BUCKET=vitrina-private
VITRINA_S3_BACKUP_BUCKET=vitrina-backup
VITRINA_PUBLIC_MEDIA_URL=https://s3.example.kz/vitrina-photos

# Sign-in codes go out by SMS through Mobizon (mobizon.kz). The key: Mobizon account -> API settings -> enable API
# access (allow only this server's IP there). Each code costs money: keep the balance topped up.
VITRINA_SMS_PROVIDER=mobizon
VITRINA_MOBIZON_API_KEY=
# A sender name registered and approved in the Mobizon account (e.g. VITRINA); empty: Mobizon's shared one.
VITRINA_MOBIZON_FROM=
