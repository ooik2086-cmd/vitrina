# Copy of what deploy/setup.sh writes to deploy/.env. Never commit .env: it holds the secrets.

# The site's name and an email Let's Encrypt writes to about the certificate. The domain's A record must point
# at this server before the first start.
VITRINA_DOMAIN=vitrina.kz
VITRINA_TLS=you@example.kz
# Browser origins allowed to call the API: the site itself (the support console at /admin is served from it).
VITRINA_CORS_ORIGINS=https://vitrina.kz

# Made by setup.sh: random, at least 32 characters. Keep a copy somewhere safe: without POSTGRES_PASSWORD the
# backups still restore, but sign-in codes and webhook signatures change if the others are lost.
POSTGRES_PASSWORD=
VITRINA_OTP_SECRET=
VITRINA_PAYMENT_SECRET=
VITRINA_DELIVERY_SECRET=

# Where photos and private files (receipts, dispute evidence) are kept. setup.sh writes disk.
#   disk  this server's own disk (Docker volumes media and private); Caddy serves the photos at
#         https://DOMAIN/media. The nightly backup copies them, with the database, to /var/backups/vitrina: copy
#         that folder off the server regularly (deploy/README.md), or a lost server loses everything.
#   s3    S3-compatible storage keeping the data in Kazakhstan (the personal-data law): fill the S3 lines below,
#         and VITRINA_PUBLIC_MEDIA_URL becomes the photos bucket's public address (or a CDN's).
VITRINA_STORAGE=
# The site's own address, and where phones load photos from (on disk: the site's address + /media).
VITRINA_PUBLIC_API_URL=
VITRINA_PUBLIC_MEDIA_URL=

# S3: three buckets on one endpoint (with disk, all may stay empty; the backup bucket alone may be set, and then
# the database's copies leave the server every night, but the photos do not).
#   VITRINA_S3_BUCKET          photos, public read
#   VITRINA_S3_PRIVATE_BUCKET  receipts and dispute evidence, NOT public
#   VITRINA_S3_BACKUP_BUCKET   the database's nightly copies, NOT public (its own key, if any: deploy/backup.env)
VITRINA_S3_ENDPOINT=
VITRINA_S3_REGION=us-east-1
VITRINA_S3_ACCESS_KEY=
VITRINA_S3_SECRET_KEY=
VITRINA_S3_BUCKET=
VITRINA_S3_PRIVATE_BUCKET=
VITRINA_S3_BACKUP_BUCKET=

# Sign-in codes go out by SMS through Mobizon (mobizon.kz). The key: Mobizon account -> API settings -> enable API
# access (allow only this server's IP there). Each code costs money: keep the balance topped up.
VITRINA_SMS_PROVIDER=mobizon
VITRINA_MOBIZON_API_KEY=
# A sender name registered and approved in the Mobizon account (e.g. VITRINA); empty: Mobizon's shared one.
VITRINA_MOBIZON_FROM=

# Who runs the site and where people write about their data: shown on https://DOMAIN/privacy and
# https://DOMAIN/delete-account (the personal-data law; Google Play asks for both pages). For example
# VITRINA_OPERATOR=ИП Сапар А., ИИН 000000000000 and VITRINA_SUPPORT_CONTACT=help@vitrina.kz
VITRINA_OPERATOR=
VITRINA_SUPPORT_CONTACT=

# Online payment. off until a licensed payment partner is connected: no orders or price offers, the app's buy
# button opens the chat with the seller instead. The API does not start in production with anything else for now.
VITRINA_PAYMENTS=off
