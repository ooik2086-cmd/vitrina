# The photos (VITRINA_STORAGE=disk), served from their volume by a Caddy of their own: it holds no certificate or
# other secret, so a link planted in the volume could expose nothing worth having. Only names the API makes
# (owner/32 hex digits.ext) are served; anything else is 404. The site's Caddy passes /media/* here.
{
	admin off
	persist_config off
}

:8080 {
	handle /health {
		respond 200
	}
	@photo path_regexp ^/[0-9]+/[0-9a-f]{32}\.(jpg|webp|png|mp4)$
	handle @photo {
		root * /srv/media
		header X-Content-Type-Options nosniff
		# A name is random and never reused (an edit makes a new one): phones may keep a photo for a year. Only
		# when it is there: a 404 (say, before restore.sh --files) must not be remembered.
		@there file
		header @there Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		respond 404
	}
}
